# The Qt prototype is an independent CMake project with overlapping class names.
compilation_database_dir: build/ui
output_directory: docs/uml
relative_to: .
generate_metadata: false

diagrams:
  gui_prototype:
    type: class
    glob:
      - UI/*.cpp
      - UI/**/*.cpp
    include:
      paths:
        - UI
    exclude:
      namespaces:
        - std
    generate_packages: false
    generate_method_arguments: full
    include_relations_also_as_members: true
    plantuml:
      before:
        - "skinparam classAttributeIconSize 0"
